# Copy to .env and set a dedicated non-sensitive workspace.
OLLAMA_HOST=http://127.0.0.1:11434
ALLOW_REMOTE_OLLAMA=false
DEFAULT_MODEL=

# Required. Never use /, your home directory, or a broad top-level directory.
WORKSPACE_ROOT=/absolute/path/to/dedicated/workspace
FOLLOW_SYMLINKS=false
DENYLIST_NAMES=.env,.env.local,.env.production,.git/config,.harness-snapshots,id_rsa,id_ed25519,credentials

RATE_LIMIT_RPM=20
MAX_CONCURRENT_REQUESTS=2
COOLDOWN_SECONDS=30
COOLDOWN_TRIGGER_COUNT=3

MAX_ITERATIONS=25
MAX_WALL_CLOCK_SECONDS=600
MAX_OUTPUT_TOKENS_PER_TURN=2048
MAX_TOTAL_TOKENS_PER_SESSION=100000

MAX_FILE_READ_BYTES=1000000
MAX_FILE_WRITE_BYTES=2000000
MAX_FILES_INDEXED=20000

# The executor is fail-closed by default. Enable only after deploying a verified OS sandbox runner.
EXEC_ALLOWLIST=git,ls,cat,grep,rg,python3,pytest,npm,node,pip
EXEC_TIMEOUT_SECONDS=60
EXEC_REQUIRE_OS_SANDBOX=true

REQUIRE_APPROVAL_FOR=write,delete,exec,git_commit,git_checkout
AUTO_APPROVE=
DRY_RUN_DEFAULT=true

AUDIT_LOG_PATH=./data/audit.log
SQLITE_PATH=./data/harness.db
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
